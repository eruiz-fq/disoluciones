        function handleEnterKey() {
            if (!state.answered) {
                checkAnswer();
            } else {
                nextProblem();
            }
        }

        function checkAnswer() {
            if (state.answered) return;
            const rawInput = document.getElementById('user-answer').value.trim().replace(',', '.');
            if (rawInput === '' || isNaN(Number(rawInput))) {
                document.getElementById('user-answer').focus();
                return;
            }

            const userVal = parseFloat(rawInput);
            const p = state.currentProblem;
            const expected = p.answer;
            const relError = Math.abs(userVal - expected) / Math.max(Math.abs(expected), 1e-6);
            const isCorrect = relError <= 0.035 || Math.abs(userVal - expected) <= 0.02;

            state.answered = true;
            document.getElementById('user-answer').disabled = true;
            document.getElementById('btn-check').disabled = true;
            document.getElementById('btn-check').classList.add('opacity-50', 'cursor-not-allowed');

            if (isCorrect) {
                state.hits++;
                state.streak++;
                if (state.streak > state.record) state.record = state.streak;
                state.catCounts[p.cat]++;
            } else {
                state.streak = 0;
            }

            updateScoreUI();

            // Guardar en el historial para el informe PDF
            state.history.push({
                num: state.questionCounter,
                catEs: p.catLabelEs,
                catCa: p.catLabelCa,
                solute: p.solute.formula,
                userVal: `${userVal} ${p.unit}`,
                expectedVal: `${roundTo(expected, 2)} ${p.unit}`,
                correct: isCorrect
            });

            // Mostrar Feedback
            const fbBox = document.getElementById('feedback-box');
            const t = I18N[state.lang];
            fbBox.classList.remove('hidden', 'bg-emerald-50/90', 'border-emerald-300', 'text-emerald-950', 'bg-rose-50/90', 'border-rose-300', 'text-rose-950');

            if (isCorrect) {
                fbBox.classList.add('bg-emerald-50/90', 'border-emerald-300', 'text-emerald-950');
                document.getElementById('fb-icon').textContent = '✅';
                document.getElementById('fb-title').textContent = t.correctTitle;
            } else {
                fbBox.classList.add('bg-rose-50/90', 'border-rose-300', 'text-rose-950');
                document.getElementById('fb-icon').textContent = '❌';
                document.getElementById('fb-title').textContent = t.wrongTitle;
            }

            document.getElementById('fb-subtitle').innerHTML = `${t.yourValLabel} <strong>${userVal} ${p.unit}</strong> · ${t.expectedLabel} <strong>${roundTo(expected, 2)} ${p.unit}</strong>`;
            document.getElementById('fb-steps').innerHTML = state.lang === 'es' ? p.stepsEs : p.stepsCa;

            renderMath();
        }

