        function resetFactorChain() {
            state.guidedChainIndex = 0;
            state.guidedShuffledPool.forEach(card => card.used = false);
            renderFactorBoard();
        }

        function renderFactorBoard() {
            const p = state.currentProblem;
            if (!p || !p.guided) return;
            const g = p.guided;
            const board = document.getElementById('factor-chain-board');
            board.innerHTML = '';

            const currentIdx = state.guidedChainIndex;
            const totalSteps = g.steps.length;

            // Determinar si la unidad inicial ya ha sido cancelada por algún paso elegido
            const firstStepCancelsInitNum = currentIdx >= 1 && g.steps[0].cancels === 'num';
            const anyStepCancelsInitDen = g.steps.slice(0, currentIdx).some(s => s.cancels === 'den');

            // 1. Bloque de dato inicial
            const initBlock = document.createElement('div');
            initBlock.className = "bg-slate-100 border border-slate-300 rounded-xl px-3.5 py-2 flex flex-col items-center justify-center text-xs font-bold";
            if (g.initDenUnit) {
                initBlock.innerHTML = `
                    <div class="pb-1 border-b border-slate-400 w-full text-center">
                        <span class="font-mono-num text-slate-900">${g.initNumVal}</span>
                        <span class="ml-1 px-1.5 py-0.5 rounded bg-indigo-100 text-indigo-900 ${firstStepCancelsInitNum ? 'unit-cancelled' : ''}">${g.initNumUnit}</span>
                    </div>
                    <div class="pt-1 w-full text-center">
                        <span class="font-mono-num text-slate-900">${g.initDenVal}</span>
                        <span class="ml-1 px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 ${anyStepCancelsInitDen ? 'unit-cancelled' : ''}">${g.initDenUnit}</span>
                    </div>
                `;
            } else {
                initBlock.innerHTML = `
                    <div class="py-1 text-center">
                        <span class="font-mono-num text-slate-900 text-sm">${g.initNumVal}</span>
                        <span class="ml-1 px-2 py-0.5 rounded bg-indigo-100 text-indigo-900 ${firstStepCancelsInitNum ? 'unit-cancelled' : ''}">${g.initNumUnit}</span>
                    </div>
                `;
            }
            board.appendChild(initBlock);

            // 2. Factores encadenados hasta currentIdx
            for (let i = 0; i < currentIdx; i++) {
                const step = g.steps[i];
                // ¿El numerador de este paso se cancela en un paso posterior?
                const nextCancelsThisNum = g.steps.slice(i + 1, currentIdx).some(later => later.denUnit === step.numUnit);
                // El denominador de este paso cancela una unidad anterior inmediatamente al colocarse
                const thisDenCancelled = step.cancels === 'num';
                const thisNumCancelledImmediately = step.cancels === 'den';

                const dot = document.createElement('span');
                dot.className = "font-black text-slate-400 text-lg px-0.5";
                dot.textContent = "·";
                board.appendChild(dot);

                const factorEl = document.createElement('div');
                factorEl.className = "bg-indigo-50/70 border border-indigo-300 rounded-xl px-3.5 py-2 flex flex-col items-center justify-center text-xs font-bold animate-pop";
                factorEl.innerHTML = `
                    <div class="pb-1 border-b border-indigo-300 w-full text-center">
                        <span class="font-mono-num text-slate-900">${step.numVal}</span>
                        <span class="ml-1 px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-900 ${(nextCancelsThisNum || thisNumCancelledImmediately) ? 'unit-cancelled' : ''}">${step.numUnit}</span>
                    </div>
                    <div class="pt-1 w-full text-center">
                        <span class="font-mono-num text-slate-900">${step.denVal}</span>
                        <span class="ml-1 px-1.5 py-0.5 rounded bg-rose-100 text-rose-900 ${thisDenCancelled ? 'unit-cancelled' : ''}">${step.denUnit}</span>
                    </div>
                `;
                board.appendChild(factorEl);
            }

            // 3. Hueco pendiente o símbolo "=" final
            const statusEl = document.getElementById('factor-chain-status');
            if (currentIdx < totalSteps) {
                const dot = document.createElement('span');
                dot.className = "font-black text-slate-400 text-lg px-0.5";
                dot.textContent = "·";
                board.appendChild(dot);

                const slot = document.createElement('div');
                slot.className = "border-2 border-dashed border-indigo-300 bg-indigo-50/30 rounded-xl px-4 py-3 text-xs font-bold text-indigo-500 flex items-center justify-center";
                slot.textContent = state.lang === 'es' ? `Factor ${currentIdx + 1} de ${totalSteps}` : `Factor ${currentIdx + 1} de ${totalSteps}`;
                board.appendChild(slot);

                statusEl.innerHTML = state.lang === 'es'
                    ? `<span>Progreso de factores: <strong>${currentIdx} / ${totalSteps}</strong></span>`
                    : `<span>Progrés de factors: <strong>${currentIdx} / ${totalSteps}</strong></span>`;
            } else {
                const eq = document.createElement('span');
                eq.className = "font-black text-emerald-600 text-sm px-2 py-1 bg-emerald-50 rounded-lg border border-emerald-200 animate-pop";
                eq.innerHTML = state.lang === 'es'
                    ? `= ¡Unidades listas (${p.unit})! Introduce el resultado abajo 👇`
                    : `= Unitats llestes (${p.unit})! Introdueix el resultat a baix 👇`;
                board.appendChild(eq);

                statusEl.innerHTML = state.lang === 'es'
                    ? `<span class="text-emerald-700">✓ ¡Todas las unidades intermedias se han cancelado correctamente! Ahora multiplica numeradores y divide entre denominadores.</span>`
                    : `<span class="text-emerald-700">✓ Totes les unitats intermèdies s'han cancel·lat correctament! Ara multiplica numeradors i divideix entre denominadors.</span>`;
            }

            // Renderizar banco de tarjetas
            const poolContainer = document.getElementById('factor-cards-pool');
            poolContainer.innerHTML = '';
            state.guidedShuffledPool.forEach((card) => {
                const btn = document.createElement('button');
                btn.disabled = card.used || currentIdx >= totalSteps;
                btn.className = `factor-card rounded-xl border px-3.5 py-2 text-xs font-bold flex flex-col items-center ${
                    card.used
                        ? 'opacity-35 bg-slate-100 border-slate-200 cursor-not-allowed'
                        : 'bg-white border-slate-300 hover:border-[#4f46e5] text-slate-800 shadow-sm cursor-pointer'
                }`;
                btn.innerHTML = `
                    <div class="pb-1 border-b border-slate-300 w-full text-center">
                        <span class="font-mono-num text-[#4f46e5]">${card.numVal}</span> <span>${card.numUnit}</span>
                    </div>
                    <div class="pt-1 w-full text-center">
                        <span class="font-mono-num text-[#4f46e5]">${card.denVal}</span> <span>${card.denUnit}</span>
                    </div>
                `;
                btn.onclick = () => selectFactorCard(card, btn);
                poolContainer.appendChild(btn);
            });
        }

        function selectFactorCard(card, btnEl) {
            const expectedIdx = state.guidedChainIndex;
            if (card.isCorrectStep === expectedIdx) {
                card.used = true;
                state.guidedChainIndex++;
                renderFactorBoard();
                if (state.guidedChainIndex === state.currentProblem.guided.steps.length) {
                    document.getElementById('user-answer').focus();
                }
            } else {
                btnEl.classList.add('border-rose-500', 'bg-rose-50');
                const statusEl = document.getElementById('factor-chain-status');
                statusEl.innerHTML = state.lang === 'es'
                    ? `<span class="text-rose-600">✗ Ese factor no cancela la unidad anterior (o tiene el numerador y denominador invertidos). Fíjate qué unidad necesitas tachar.</span>`
                    : `<span class="text-rose-600">✗ Aquest factor no cancel·la la unitat anterior (o té el numerador i denominador invertits). Fixa't quina unitat necessites ratllar.</span>`;
                setTimeout(() => {
                    btnEl.classList.remove('border-rose-500', 'bg-rose-50');
                }, 900);
            }
        }

