        function setPracticeMode(mode) {
            state.practiceMode = mode;
            const btnDirect = document.getElementById('btn-mode-direct');
            const btnGuided = document.getElementById('btn-mode-guided');

            if (mode === 'direct') {
                btnDirect.className = "px-3.5 py-1.5 rounded-lg transition-all bg-white text-[#4f46e5] shadow-sm flex items-center gap-1.5";
                btnGuided.className = "px-3.5 py-1.5 rounded-lg transition-all text-slate-600 hover:text-slate-900 flex items-center gap-1.5";
                document.getElementById('guided-workspace').classList.add('hidden');
                document.getElementById('btn-hint').classList.remove('hidden');
            } else {
                btnGuided.className = "px-3.5 py-1.5 rounded-lg transition-all bg-white text-[#4f46e5] shadow-sm flex items-center gap-1.5";
                btnDirect.className = "px-3.5 py-1.5 rounded-lg transition-all text-slate-600 hover:text-slate-900 flex items-center gap-1.5";
                document.getElementById('guided-workspace').classList.remove('hidden');
                document.getElementById('btn-hint').classList.add('hidden');
                document.getElementById('hint-box').classList.add('hidden');
            }
            initGuidedForCurrentProblem();
        }

        function initGuidedForCurrentProblem() {
            const p = state.currentProblem;
            if (!p || !p.guided) return;

            state.guidedStep1Done = false;
            state.guidedChainIndex = 0;

            // Preparar pool barajado de tarjetas de factores
            const pool = [
                ...p.guided.steps.map((s, idx) => ({ ...s, isCorrectStep: idx, used: false })),
                ...p.guided.distractors.map(d => ({ ...d, isCorrectStep: -1, used: false }))
            ];
            state.guidedShuffledPool = shuffleArray(pool);

            document.getElementById('guided-step2-box').classList.add('hidden');
            const fb1 = document.getElementById('guided-s1-feedback');
            fb1.classList.add('hidden');

            renderGuidedStep1();
            renderFactorBoard();
        }

        function renderGuidedStep1() {
            const p = state.currentProblem;
            if (!p || !p.guided) return;
            const g = p.guided;

            document.getElementById('guided-s1-question').innerHTML = state.lang === 'es' ? g.questionEs : g.questionCa;
            const opts = state.lang === 'es' ? g.optionsEs : g.optionsCa;
