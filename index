            const dateStr = new Date().toLocaleString(state.lang === 'ca' ? 'ca-ES' : 'es-ES');
            const timeFormatted = formatTime(state.seconds);

            const rowsHtml = state.history.length === 0
                ? `<tr><td colspan="5" style="text-align:center; padding: 18px; color:#64748b;">No se han registrado ejercicios respondidos en esta sesión.</td></tr>`
                : state.history.map(item => `
                    <tr>
                        <td style="padding:8px 12px; border-bottom:1px solid #e2e8f0; font-weight:700;">#${item.num}</td>
                        <td style="padding:8px 12px; border-bottom:1px solid #e2e8f0;">${state.lang === 'ca' ? item.catCa : item.catEs} (${item.solute})</td>
                        <td style="padding:8px 12px; border-bottom:1px solid #e2e8f0; font-family:monospace;">${item.userVal}</td>
                        <td style="padding:8px 12px; border-bottom:1px solid #e2e8f0; font-family:monospace;">${item.expectedVal}</td>
                        <td style="padding:8px 12px; border-bottom:1px solid #e2e8f0; font-weight:700; color:${item.correct ? '#059669' : '#e11d48'};">
                            ${item.correct ? '✓ Correcto' : '✗ Incorrecto'}
