                btn.innerHTML = `<span class="text-sm font-extrabold">${s.formula}</span><span class="text-[10px] opacity-80">${s.mm} g/mol</span>`;
                container.appendChild(btn);
            });
        }

        function setLabVolume(volMl) {
            document.getElementById('lab-vol-slider').value = volMl;
            updateVirtualLab();
        }

        function updateVirtualLab() {
            const s = SOLUTES[state.labSoluteIndex];
            const mass = parseFloat(document.getElementById('lab-mass-slider').value);
            const volMl = parseFloat(document.getElementById('lab-vol-slider').value);
            const volL = roundTo(volMl / 1000, 3);

            document.getElementById('lab-mass-val').textContent = mass;
            document.getElementById('lab-vol-val').textContent = volMl;
            document.getElementById('lab-vol-l-val').textContent = volL;

            // Resaltar botón de aforo estándar si coincide
            [100, 250, 500, 1000].forEach(v => {
                const b = document.getElementById(`btn-vol-${v}`);
                if (b) {
                    b.className = (v === volMl)
                        ? "py-2 rounded-xl border text-xs font-bold transition bg-[#4f46e5] text-white border-[#4f46e5] shadow-sm"
                        : "py-2 rounded-xl border text-xs font-bold transition bg-white text-slate-700 border-slate-200 hover:bg-slate-100";
                }
            });

            const moles = mass / s.mm;
            const molarity = moles / volL;
            const gl = mass / volL;

            document.getElementById('lab-out-moles').textContent = `${roundTo(moles, 2)} mol`;
            document.getElementById('lab-out-molarity').textContent = `${roundTo(molarity, 2)} M`;
            document.getElementById('lab-out-gl').textContent = `${roundTo(gl, 1)} g/L`;
            document.getElementById('lab-molarity-inside').textContent = `${roundTo(molarity, 2)} M`;
            document.getElementById('lab-svg-vol-text').textContent = `${volMl} mL`;
            document.getElementById('lab-flask-size-badge').textContent = state.lang === 'ca' ? `Matràs de ${volMl} mL` : `Matraz de ${volMl} mL`;

            // 1. ESCALADO DEL TAMAÑO DEL MATRAZ SEGÚN VOLUMEN (100 mL -> pequeño, 1000 mL -> grande)
            // El líquido siempre permanece enrasado en la marca de aforo del cuello.
            const scaleFactor = 0.64 + ((volMl - 100) / 900) * 0.38; // Rango de escala 0.64 a 1.02
            const scalerEl = document.getElementById('lab-flask-scaler');
            scalerEl.style.transform = `scale(${roundTo(scaleFactor, 3)})`;

            // 2. OSCURECIMIENTO DEL COLOR SEGÚN LA CONCENTRACIÓN MOLAR (Ley de Beer-Lambert visual)
            // Cuanto mayor es la molaridad M, mayor opacidad y menor luminosidad RGB (más oscuro)
            const normConc = Math.min(molarity / 3.0, 1); // Normalizado de 0 a 3.0 M
            const darkenFactor = 1 - (normConc * 0.58);  // Oscurece los canales RGB hasta un 58%
            const r = Math.round(s.rgb[0] * darkenFactor);
            const g = Math.round(s.rgb[1] * darkenFactor);
            const b = Math.round(s.rgb[2] * darkenFactor);
            const alpha = roundTo(0.22 + normConc * 0.73, 2); // Opacidad de 0.22 (muy diluido) a 0.95 (muy concentrado)

            const svgLiquid = document.getElementById('lab-svg-liquid');
            svgLiquid.setAttribute('fill', `rgb(${r}, ${g}, ${b})`);
            svgLiquid.setAttribute('fill-opacity', alpha);

            let intensityLabel = state.lang === 'ca' ? 'Diluïda (clar)' : 'Diluida (claro)';
            if (normConc > 0.66) intensityLabel = state.lang === 'ca' ? 'Molt concentrada (fosc)' : 'Muy concentrada (oscuro)';
            else if (normConc > 0.28) intensityLabel = state.lang === 'ca' ? 'Concentració mitjana' : 'Concentración media';
            document.getElementById('lab-color-intensity-badge').textContent = intensityLabel;

            // Ecuación en tiempo real con factores
            const mathEl = document.getElementById('lab-live-math');
            mathEl.innerHTML = `
                $$M = \\frac{${mass}\\text{ g }${s.latex}}{${volMl}\\text{ mL}} \\cdot \\frac{1\\text{ mol }${s.latex}}{${s.mm}\\text{ g }${s.latex}} \\cdot \\frac{1000\\text{ mL}}{1\\text{ L}} = \\mathbf{${roundTo(molarity, 2)}\\text{ mol/L}}$$
            `;
            renderMath();
        }

